HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-hermes-api-key
DEFAULT_MODEL=hermes-agent
PORT=50091
HOST=0.0.0.0
FILE_STORE_DIR=/app/data/agent-console/files
INBOX_FILE_STORE_DIR=/app/data/agent-console/inbox-files
PUBLIC_BASE_URL=http://192.168.34.65:50091
VECTOR_SEARCH_HOST=http://192.168.34.65:8900

# Optional. If set, browser/backend clients must send:
# Authorization: Bearer <PROXY_API_KEY>
PROXY_API_KEY=

# Comma-separated origins, or * for internal testing.
CORS_ORIGINS=*
SESSION_HMAC_SECRET=replace-with-at-least-32-random-bytes
GATEWAY_BRIDGE_TOKEN=replace-with-a-different-32-byte-token
WEBUI_FEEDBACK_BRIDGE_TOKEN=replace-with-another-32-byte-token

# LogMonitor installation is server-to-server only.
I2STREAM_INSTALL_INTERNAL_TOKEN=replace-with-an-install-token-of-at-least-32-bytes
AGENT_PUBLIC_HOST=
AGENT_BASE_URL_PORT=8642
AGENT_BACK_PORT=50091
LOGMONITOR_IMAGE_PATH=/app/data/image/stream_node_mcp.tar.gz
LOGMONITOR_START_SCRIPT_PATH=/app/logmonitor-installer/start_stream_mcp.sh
LOGMONITOR_KNOWN_HOSTS_PATH=/app/data/agent-console/logmonitor-ssh/known_hosts
LOGMONITOR_PREFLIGHT_TTL_SECONDS=300

# Chat history persistence is stored at /app/data/agent-console/chat.db.
# /app/data is mounted to the host in container deployments.
